[Unit]
Description=RapidOCR persistent worker
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/sistema-cuadre-caja
EnvironmentFile=/opt/sistema-cuadre-caja/backend/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/rapidocr-venv/bin/uvicorn ocr-service.worker:app --host 127.0.0.1 --port 8000 --workers 1
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
