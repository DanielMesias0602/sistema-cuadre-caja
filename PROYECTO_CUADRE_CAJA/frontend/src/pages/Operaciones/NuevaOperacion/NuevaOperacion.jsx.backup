import { useState } from 'react';
import { useNavigate } from 'react-router-dom';
import { CheckCircle } from 'lucide-react';
import { ErrorBoundary } from '../../../components/ui/ErrorBoundary';
import { StepIndicator } from './StepIndicator';
import { Paso1Evidencia } from './Paso1Evidencia';
import { Paso2RevisionOCR } from './Paso2RevisionOCR';
import { Paso3Registro } from './Paso3Registro';
import { Paso4Confirmacion } from './Paso4Confirmacion';

function NuevaOperacionContent() {
  const navigate = useNavigate();
  const [currentStep, setCurrentStep] = useState(1);
  const [datos, setDatos] = useState({
    evidencia: null,
    tipoEvidencia: null,
    tipoDocumento: 'COMPROBANTE',
    comprobante: {},
    pagos: [],
    estado: '',
  });
  const [success, setSuccess] = useState(false);

  const totalSteps = 4;

  const handlePaso1Next = (data) => {
    setDatos((prev) => ({ ...prev, evidencia: data.evidencia, tipoEvidencia: data.tipo }));
    // Si hay evidencia (imagen o PDF), ir al Paso 2 para OCR
    // Si es registro manual, ir directo al Paso 3
    if (data.evidencia) {
      setCurrentStep(2);
    } else {
      setCurrentStep(3);
    }
  };

  const handleSkipToManual = () => {
    setDatos((prev) => ({ ...prev, evidencia: null }));
    setCurrentStep(3);
  };

  const handlePaso2Next = (data) => {
    setDatos((prev) => ({ ...prev, comprobante: data }));
    setCurrentStep(3);
  };

  const handlePaso3Next = (data) => {
    setDatos((prev) => ({ ...prev, ...data }));
    setCurrentStep(4);
  };

  const handlePaso4Success = (operacion) => {
    setSuccess(true);
    setTimeout(() => {
      navigate('/operaciones');
    }, 2000);
  };

  const handleBack = () => {
    if (currentStep > 1) {
      setCurrentStep((prev) => prev - 1);
    }
  };

  if (success) {
    return (
      <div className="flex flex-col items-center justify-center py-20">
        <div className="w-20 h-20 rounded-full bg-green-100 flex items-center justify-center mb-6">
          <CheckCircle className="w-10 h-10 text-green-500" />
        </div>
        <h2 className="text-2xl font-bold text-slate-900 mb-2">¡Operación registrada!</h2>
        <p className="text-slate-500">Redirigiendo a la lista de operaciones...</p>
      </div>
    );
  }

  return (
    <div className="max-w-4xl mx-auto">
      <div className="mb-6">
        <nav className="text-sm text-slate-500 mb-2">
          <span className="hover:text-slate-700 cursor-pointer" onClick={() => navigate('/operaciones')}>
            Operaciones
          </span>
          <span className="mx-2">/</span>
          <span className="text-slate-900 font-medium">Nueva operación</span>
        </nav>
      </div>

      <StepIndicator currentStep={currentStep} totalSteps={totalSteps} />

      <div className="bg-white rounded-xl shadow-sm border border-gray-100 p-6">
        {currentStep === 1 && (
          <Paso1Evidencia
            onNext={handlePaso1Next}
            onSkipToManual={handleSkipToManual}
          />
        )}

        {currentStep === 2 && (
          <Paso2RevisionOCR
            evidencia={datos.evidencia}
            tipoEvidencia={datos.tipoEvidencia}
            onNext={handlePaso2Next}
            onBack={handleBack}
          />
        )}

        {currentStep === 3 && (
          <Paso3Registro
            comprobanteData={datos.comprobante}
            onNext={handlePaso3Next}
            onBack={handleBack}
          />
        )}

        {currentStep === 4 && (
          <Paso4Confirmacion
            datos={datos}
            onBack={handleBack}
            onSuccess={handlePaso4Success}
          />
        )}
      </div>
    </div>
  );
}

export function NuevaOperacion() {
  return (
    <ErrorBoundary>
      <NuevaOperacionContent />
    </ErrorBoundary>
  );
}

export default NuevaOperacion;
